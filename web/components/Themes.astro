---
// OWNER: ui-builder. Thematic blocks as accessible tabs (no-JS: all panels stacked).
import type { SiteContent } from '../i18n';
import SectionHead from './SectionHead.astro';
import WordCard from './WordCard.astro';
interface Props { c: SiteContent }
const { c } = Astro.props;
const t = c.themes;
---
<section id="themes" class="section section--tint" aria-labelledby="themes-title">
  <div class="container">
    <SectionHead c={c} id="themes" title={t.title} lead={t.lead} />

    <div class="themes" data-tabs>
      <div class="tabs reveal" role="tablist" aria-labelledby="themes-title" hidden>
        {t.blocks.map((b, i) => (
          <button
            type="button"
            class="tab"
            role="tab"
            id={`tab-${b.id}`}
            aria-controls={`theme-${b.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="tab__emoji" aria-hidden="true">{b.emoji}</span>
            <span class="tab__title">{b.title}</span>
            <span class="tab__count" aria-hidden="true">{b.words.length}</span>
          </button>
        ))}
      </div>

      {t.blocks.map((b) => (
        <div class="panel" id={`theme-${b.id}`} role="region" aria-labelledby={`theme-${b.id}-title`} data-panel>
          <div class="panel__head">
            <span class="panel__emoji" aria-hidden="true">{b.emoji}</span>
            <div>
              <h3 id={`theme-${b.id}-title`} class="panel__title">{b.title}</h3>
              <p class="panel__lead">{b.lead}</p>
            </div>
          </div>
          <ul class="words">
            {b.words.map((w, i) => <WordCard w={w} delay={(i % 3) * 0.06} />)}
          </ul>
          <aside class="takeaway">
            <span class="takeaway__mark" aria-hidden="true">✦</span>
            <p>{b.takeaway}</p>
          </aside>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 0.35rem;
    border-radius: 999px;
    background: var(--paper-3);
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs[hidden] { display: none; }
  @media (max-width: 640px) {
    .tabs { flex-direction: column; width: 100%; border-radius: var(--r); gap: 0.2rem; }
    .tab { border-radius: 12px; }
    .tab__count { margin-left: auto; }
  }
  .tab {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s, box-shadow 0.25s;
  }
  .tab:hover { color: var(--ink); }
  .tab[aria-selected='true'] { background: var(--card); color: var(--ink); box-shadow: var(--shadow-sm); }
  .tab__emoji { font-size: 1.1rem; }
  .tab__count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: var(--paper);
    color: var(--ink-mute);
  }

  .panel + .panel { margin-top: clamp(3rem, 6vw, 5rem); }
  :global(.js) [data-tabs].is-ready .panel + .panel { margin-top: 0; }
  .panel[hidden] { display: none; }

  .panel__head { display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 1.75rem; max-width: var(--measure); }
  .panel__emoji {
    flex: none;
    display: grid; place-items: center;
    width: 3.25rem; height: 3.25rem;
    border-radius: 16px;
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    font-size: 1.6rem;
  }
  .panel__title { font-size: var(--fs-h3); margin-bottom: 0.4rem; }
  .panel__lead { color: var(--ink-soft); }

  .words {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15.5rem), 1fr));
  }

  .takeaway {
    position: relative;
    display: flex;
    gap: 0.9rem;
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    max-width: var(--measure);
    border-left: 3px solid var(--red);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    background: color-mix(in srgb, var(--red-soft) 45%, transparent);
  }
  .takeaway__mark { color: var(--red); line-height: 1.7; }
  .takeaway p { font-family: var(--font-serif); font-style: italic; font-size: 1.12rem; line-height: 1.55; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    if (!list || tabs.length < 2) return;

    list.hidden = false;
    root.classList.add('is-ready');
    panels.forEach((p) => {
      p.setAttribute('role', 'tabpanel');
      const tab = tabs.find((t) => t.getAttribute('aria-controls') === p.id);
      if (tab) p.setAttribute('aria-labelledby', tab.id);
      p.tabIndex = 0;
    });

    const select = (idx: number, focus = false) => {
      tabs.forEach((t, i) => {
        const on = i === idx;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls')!);
        if (panel) {
          panel.hidden = !on;
          if (on) panel.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
        }
      });
      if (focus) tabs[idx].focus();
    };

    // honour #theme-xxx deep links
    const fromHash = tabs.findIndex((t) => `#${t.getAttribute('aria-controls')}` === location.hash);
    select(fromHash >= 0 ? fromHash : 0);

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        let n = -1;
        if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') n = 0;
        else if (e.key === 'End') n = tabs.length - 1;
        if (n >= 0) {
          e.preventDefault();
          select(n, true);
        }
      });
    });
  });
</script>
