---
// OWNER: ui-builder. False friends: flip cards (button + aria-pressed) and a compact cheat-sheet table.
import type { SiteContent } from '../i18n';
import SectionHead from './SectionHead.astro';
interface Props { c: SiteContent }
const { c } = Astro.props;
const f = c.falseFriends;
---
<section id="false-friends" class="section" aria-labelledby="false-friends-title">
  <div class="container">
    <SectionHead c={c} id="false-friends" title={f.title} lead={f.lead} />

    <ul class="ff-grid">
      {f.items.map((it, i) => (
        <li class="reveal" style={`--reveal-delay:${(i % 3) * 0.06}s`}>
          <button type="button" class="flip" aria-pressed="false" data-flip>
            <span class="flip__inner">
              <span class="flip__face flip__front" data-face="front">
                <span class="flip__pair">
                  <span class="flip__word">
                    <span class="tag tag--fr" aria-hidden="true">fr</span>
                    <span class="flip__w" lang="fr">{it.fr}</span>
                  </span>
                  <span class="flip__neq" aria-hidden="true">≠</span>
                  <span class="flip__word">
                    <span class="tag tag--en" aria-hidden="true">en</span>
                    <span class="flip__w" lang="en">{it.en}</span>
                  </span>
                </span>
                <span class="flip__hint">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10a6 6 0 0 1 10.5-4M16 10a6 6 0 0 1-10.5 4M14.5 2.5v3.5H11M5.5 17.5V14H9" /></svg>
                  {c.ui.flipHint}
                </span>
              </span>
              <span class="flip__face flip__back" data-face="back">
                <span class="flip__row">
                  <span class="flip__k" lang="fr">{it.fr}</span>
                  <span class="flip__v">{it.frMeaning}</span>
                </span>
                <span class="flip__row">
                  <span class="flip__k flip__k--en" lang="en">{it.en}</span>
                  <span class="flip__v">{it.enMeaning}</span>
                </span>
                <span class="flip__correct">
                  <span aria-hidden="true">✓</span>
                  <span>{it.correct}</span>
                </span>
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>

    <div class="ff-table-wrap reveal">
      <table class="ff-table" aria-labelledby="false-friends-title">
        <thead>
          <tr>
            <th scope="col"><span class="tag tag--fr">fr</span></th>
            <th scope="col"><span class="tag tag--en">en</span></th>
            <th scope="col"><span class="tag">✓</span></th>
          </tr>
        </thead>
        <tbody>
          {f.items.map((it) => (
            <tr>
              <td>
                <span class="ff-table__w" lang="fr"><span class="tag tag--fr ff-table__lbl" aria-hidden="true">fr</span>{it.fr}</span>
                <span class="ff-table__m">{it.frMeaning}</span>
              </td>
              <td>
                <span class="ff-table__w" lang="en"><span class="tag tag--en ff-table__lbl" aria-hidden="true">en</span>{it.en}</span>
                <span class="ff-table__m">{it.enMeaning}</span>
              </td>
              <td class="ff-table__ok">{it.correct}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .ff-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr));
  }
  .ff-grid > li { display: flex; }

  .flip {
    flex: 1;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    perspective: 1200px;
    border-radius: var(--r);
  }
  .flip__inner {
    display: grid;
    height: 100%;
    min-height: 13.5rem;
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease);
  }
  .flip__face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    padding: 1.4rem;
    border-radius: var(--r);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: box-shadow 0.3s;
  }
  .flip:hover .flip__face { box-shadow: var(--shadow); }
  .flip__front {
    background:
      radial-gradient(circle at 100% 0%, var(--red-soft), transparent 55%),
      radial-gradient(circle at 0% 100%, var(--blue-soft), transparent 55%),
      var(--card);
    justify-content: space-between;
  }
  .flip__back {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
    transform: rotateY(180deg);
    gap: 0.75rem;
  }
  .flip[aria-pressed='true'] .flip__inner { transform: rotateY(180deg); }

  .flip__pair { display: flex; flex-direction: column; gap: 0.35rem; }
  .flip__word { display: flex; align-items: center; gap: 0.6rem; }
  .flip__w { font-family: var(--font-serif); font-size: 1.55rem; font-weight: 600; line-height: 1.2; overflow-wrap: anywhere; }
  .flip__neq { font-family: var(--font-serif); font-size: 1.4rem; color: var(--red); padding-left: 0.4rem; line-height: 1; }
  .flip__hint {
    display: inline-flex; align-items: center; gap: 0.45rem;
    margin-top: 1.25rem;
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-mute);
  }
  .flip__hint svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.5s var(--ease); }
  .flip:hover .flip__hint svg { transform: rotate(180deg); }

  .flip__row { display: flex; flex-direction: column; gap: 0.1rem; }
  .flip__k { font-family: var(--font-serif); font-style: italic; font-size: 1.1rem; color: #b9c8ea; }
  .flip__k--en { color: #f0b7b0; }
  .flip__v { font-size: var(--fs-small); line-height: 1.5; }
  .flip__correct {
    display: flex; gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed color-mix(in srgb, var(--paper) 35%, transparent);
    font-size: var(--fs-small);
    font-weight: 700;
  }
  .flip__correct > span:first-child { color: #9fd3c2; }

  .flip:focus-visible { outline: none; }
  .flip:focus-visible .flip__face { outline: 2px solid var(--blue); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .flip__inner { transition: none; transform: none !important; }
    .flip__face { backface-visibility: visible; transition: opacity 0.2s; }
    .flip__back { transform: none; opacity: 0; }
    .flip[aria-pressed='true'] .flip__back { opacity: 1; }
    .flip[aria-pressed='true'] .flip__front { opacity: 0; }
  }

  /* compact cheat-sheet */
  .ff-table-wrap {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(0.5rem, 2vw, 1rem) clamp(1rem, 3vw, 1.75rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r);
    box-shadow: var(--shadow-sm);
  }
  .ff-table { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .ff-table th { text-align: left; padding: 0.75rem 0.75rem 0.6rem; border-bottom: 2px solid var(--ink); }
  .ff-table td { padding: 0.8rem 0.75rem; vertical-align: top; border-bottom: 1px solid var(--line); }
  .ff-table tr:last-child td { border-bottom: 0; }
  .ff-table__w { display: block; font-family: var(--font-serif); font-size: 1.1rem; font-weight: 600; }
  .ff-table__lbl { display: none; margin-right: 0.5rem; vertical-align: 0.2em; }
  .ff-table__m { display: block; color: var(--ink-soft); }
  .ff-table__ok { font-weight: 700; color: var(--ink); }

  @media (max-width: 640px) {
    .ff-table thead { display: none; }
    .ff-table, .ff-table tbody, .ff-table tr, .ff-table td { display: block; width: 100%; }
    .ff-table tr { padding: 0.9rem 0; border-bottom: 1px solid var(--line); }
    .ff-table tr:last-child { border-bottom: 0; }
    .ff-table td { border: 0; padding: 0.2rem 0; }
    .ff-table__lbl { display: inline-block; }
    .ff-table__ok { margin-top: 0.35rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-flip]').forEach((btn) => {
    const front = btn.querySelector<HTMLElement>('[data-face="front"]');
    const back = btn.querySelector<HTMLElement>('[data-face="back"]');
    const sync = () => {
      const on = btn.getAttribute('aria-pressed') === 'true';
      front?.setAttribute('aria-hidden', String(on));
      back?.setAttribute('aria-hidden', String(!on));
    };
    sync();
    // <button> already handles Enter / Space activation.
    btn.addEventListener('click', () => {
      btn.setAttribute('aria-pressed', String(btn.getAttribute('aria-pressed') !== 'true'));
      sync();
    });
  });
</script>
