---
// OWNER: ui-builder. Editorial pull quote.
interface Props { text: string }
const { text } = Astro.props;
---
<figure class="pq reveal">
  <svg class="pq__mark" viewBox="0 0 48 36" aria-hidden="true"><path d="M0 36V22C0 9 7 2 19 0l2 5c-7 2-10 7-10 13h9v18H0zm27 0V22C27 9 34 2 46 0l2 5c-7 2-10 7-10 13h9v18H27z" /></svg>
  <blockquote class="pq__text"><p>{text}</p></blockquote>
  <span class="pq__wave" aria-hidden="true"></span>
</figure>

<style>
  .pq {
    position: relative;
    margin: clamp(2.5rem, 5vw, 4.5rem) auto;
    max-width: 52rem;
    padding: clamp(1.75rem, 4vw, 3rem) clamp(1.25rem, 4vw, 3.5rem);
    text-align: center;
  }
  .pq__mark { width: 2.75rem; height: auto; fill: var(--red); opacity: 0.85; margin-bottom: 1rem; }
  .pq__text { margin: 0; }
  .pq__text p {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.45rem, 1.1rem + 1.7vw, 2.4rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
  }
  .pq__wave {
    display: block;
    width: 7rem; height: 12px;
    margin: 1.5rem auto 0;
    background: var(--dash-wave) repeat-x center / 48px 12px;
  }
</style>
