---
// OWNER: ui-builder. Reading rules: "pattern → sound" chips with examples and hint.
import type { SiteContent } from '../i18n';
import SectionHead from './SectionHead.astro';
interface Props { c: SiteContent }
const { c } = Astro.props;
const r = c.reading;
---
<section id="reading" class="section section--tint" aria-labelledby="reading-title">
  <div class="container">
    <SectionHead c={c} id="reading" title={r.title} lead={r.lead} />
    <ol class="rules">
      {r.rules.map((rule, i) => (
        <li class="card rule reveal" style={`--reveal-delay:${(i % 3) * 0.06}s`}>
          <span class="rule__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <p class="rule__eq">
            <span class="rule__pattern mono">{rule.pattern}</span>
            <span class="rule__arrow" aria-hidden="true">→</span>
            <span class="rule__sound ipa">{rule.sound}</span>
          </p>
          {rule.examples.length > 0 && (
            <ul class="chip-list rule__ex">
              {rule.examples.map((e) => <li class="chip" lang="en">{e}</li>)}
            </ul>
          )}
          <p class="rule__hint">{rule.hint}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .rules {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  .rule {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.4rem 1.4rem 1.5rem;
  }
  .rule__n {
    position: absolute; top: 1.1rem; right: 1.25rem;
    font-family: var(--font-serif); font-style: italic; font-size: 1.1rem; color: var(--ink-mute);
  }
  .rule__eq {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem;
    margin: 0;
    padding-right: 2rem;
  }
  .rule__pattern {
    padding: 0.3rem 0.75rem;
    border-radius: 10px;
    background: var(--ink);
    color: var(--paper);
    font-size: 1.05rem;
    font-weight: 500;
  }
  .rule__arrow { color: var(--red); font-size: 1.2rem; }
  .rule__sound {
    padding: 0.3rem 0.75rem;
    border-radius: 10px;
    background: var(--blue-soft);
    color: var(--blue);
    font-size: 1.05rem;
    font-weight: 500;
  }
  .rule__ex .chip { font-style: italic; }
  .rule__hint {
    margin-top: auto;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-soft);
  }
</style>
