---
// OWNER: ui-builder. Footer with back-to-top and language switch.
import type { SiteContent } from '../i18n';
interface Props { c: SiteContent }
const { c } = Astro.props;
const other = c.locale === 'ru' ? { href: '/en/', lang: 'en' } : { href: '/', lang: 'ru' };
---
<footer class="footer">
  <svg class="footer__wave" viewBox="0 0 1200 24" preserveAspectRatio="none" aria-hidden="true"><path d="M0 12 Q 50 0 100 12 T 200 12 T 300 12 T 400 12 T 500 12 T 600 12 T 700 12 T 800 12 T 900 12 T 1000 12 T 1100 12 T 1200 12" /></svg>
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="footer__flag" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="footer__title">{c.meta.title}</span>
    </div>
    <p class="footer__text">{c.footer.text}</p>
    <div class="footer__actions">
      <a class="footer__lang" href={other.href} hreflang={other.lang} lang={other.lang}>{c.ui.langSwitch}</a>
      <a class="back-to-top" href="#top">
        <span class="back-to-top__icon" aria-hidden="true">↑</span>
        {c.ui.backToTop}
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(2.5rem, 5vw, 3.5rem) 0 clamp(2rem, 4vw, 3rem);
    background: var(--paper-3);
  }
  .footer__wave {
    position: absolute; left: 0; top: -11px;
    width: 100%; height: 22px;
    fill: none; stroke: var(--blue); stroke-width: 1.4; stroke-dasharray: 5 7; opacity: 0.5;
  }
  .footer__inner {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }
  @media (min-width: 820px) { .footer__inner { grid-template-columns: auto 1fr auto; gap: 2rem; } }
  .footer__brand { display: flex; align-items: center; gap: 0.75rem; }
  .footer__flag { display: inline-flex; height: 1rem; border-radius: 3px; overflow: hidden; box-shadow: 0 0 0 1px var(--line); flex: none; }
  .footer__flag i { width: 0.5rem; }
  .footer__flag i:nth-child(1) { background: var(--blue); }
  .footer__flag i:nth-child(2) { background: var(--card); }
  .footer__flag i:nth-child(3) { background: var(--red); }
  .footer__title { font-family: var(--font-serif); font-weight: 600; font-size: 1.1rem; }
  .footer__text { margin: 0; font-size: var(--fs-small); color: var(--ink-soft); }
  .footer__actions { display: flex; align-items: center; gap: 0.75rem; }
  .footer__lang, .back-to-top {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: var(--fs-small);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.25s, color 0.25s;
  }
  .footer__lang { font-family: var(--font-mono); font-weight: 500; color: var(--ink); border: 1px solid var(--line-strong); }
  .footer__lang:hover { background: var(--card); color: var(--ink); }
  .back-to-top { background: var(--ink); color: var(--paper); }
  .back-to-top:hover { background: var(--red); color: var(--paper); }
  @media (prefers-reduced-motion: no-preference) {
    .back-to-top:hover .back-to-top__icon { animation: up 0.8s var(--ease) infinite; }
  }
  @keyframes up { 50% { transform: translateY(-3px); } }
</style>
